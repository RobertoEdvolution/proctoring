{{!
    @template quizaccess_proctoring/proctoring_page
    Example context (json):
    {
        "proctoringstatement": "Este examen requiere acceso a tu cámara web y micrófono."
    }
}}

<div class="proctoring-preflight-wrap">

    {{! Statement }}
    <p class="proctoring-preflight-statement">Este examen requiere acceso a tu cámara web y micrófono. Durante la prueba se tomarán fotografías y se grabará el audio para verificar tu identidad y garantizar la integridad del examen.</p>

    {{! Camera preview + mic indicator }}
    <div class="proctoring-preflight-media">
        <div class="proctoring-preflight-video-ring">
            <video id="proctoring-preflight-video" autoplay playsinline muted></video>
            <div class="proctoring-preflight-mic-badge">
                <i class="fa fa-microphone" aria-hidden="true"></i>
            </div>
        </div>
        <div id="proctoring-media-status"></div>
    </div>

</div>
